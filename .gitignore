/target
**/*.rs.bk
.DS_Store
__pycache__/
*.pyc
/dist

# `zygo.lock` is meant to be committed — the docs say so, and a project that
# does not commit it gets no benefit from it. Ignored only under `examples/`,
# where a pinned digest would refuse to come up for every reader whose image
# is newer than the one the lock was written against.
/examples/**/zygo.lock

# PoC artefacts: cross-compiled binaries, not source.
#
# `zygo-linux` is gone: it was a leftover from an earlier workflow that no
# `make` target built, and every container suite defaulted to it — so on a
# machine that still had one, twelve suites silently measured a binary from
# whenever it was last copied there. They all default to `zygo-linux-musl`
# now, and every target that runs one rebuilds it first.
/poc/poc3-linux
/poc/zygo-linux
/poc/zygo-linux-musl
/poc/zygo-linux-musl-vm

# Built by `make examples-go-linux`
/examples/warm-exec/go/bin/
# The guest kernel and the V1 probe's log: built by `make vm-kernel` and
# `make vm-probe`, 24 MB of artefact that a checkout should rebuild.
poc/vm-out/

# Development material: the roadmap, the design document, the review reports
# and the test plans. Useful to whoever is building Zygo and noise to whoever
# is using it, so it lives here rather than in `docs/`, which is for readers.
/mhmt/

# The workflow-engine example writes its queue beside itself.
examples/workflow-engine/jobs.db
