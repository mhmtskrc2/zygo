{
  "name": "zygo-sdk",
  "version": "0.1.7",
  "description": "Run untrusted code safely from Node: a client for Zygo, which gives every request a fresh, kernel-isolated sandbox in about a millisecond",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "keywords": [
    "sandbox",
    "isolation",
    "agent",
    "serverless",
    "container"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmtskrc2/zygo.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/mhmtskrc2/zygo/tree/main/sdk/node"
}
